# Build output
/berm
/berm-client
/dist/
*.exe
*.test
*.out
*.prof

# Local dev
.env
*.local

# Cascade context and charter are internal governance, versioned centrally by the
# projects-docs system, never committed to this public repo. docs/ is deliberately
# NOT ignored here: berm is public FOSS and its user and trust docs are public
# (README links into them, docs/SECURITY.md is the published trust argument).
/CLAUDE.md
/CHARTER.md

# Never commit decrypted secrets, an age key, or a live secrets dir
*.sops.decrypted
*.key
/run/
/secrets/

# Generated by the test/integration/*.sh harness scripts; the *.yml configs
# and *.sh scripts are committed, everything else in this tree is throwaway
# per-run state.
/test/integration/sources/
/test/integration/keys/
/test/integration/out/
/test/integration/sources-podman/
/test/integration/keys-podman/
/test/integration/out-podman/
